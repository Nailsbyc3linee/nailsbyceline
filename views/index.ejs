<!DOCTYPE html>
<html lang="en" class="scroll-smooth">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Primary SEO Meta Tags -->
  <title>
    <%= business.pageTitle || business.seo.title %>
  </title>
  <meta name="title" content="<%= business.pageTitle || business.seo.title %>" />
  <meta name="description" content="<%= business.pageDescription || business.seo.description %>" />
  <meta name="keywords" content="<%= business.seo.keywords %>" />
  <link rel="canonical" href="<%= business.canonical || business.seo.canonicalUrl %>" />

  <!-- Favicons and Icons -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="<%= business.ogType || 'business.business' %>" />
  <meta property="og:url" content="<%= business.canonical || business.seo.canonicalUrl %>" />
  <meta property="og:title" content="<%= business.pageTitle || business.seo.title %>" />
  <meta property="og:description" content="<%= business.pageDescription || business.seo.description %>" />
  <meta property="og:image" content="<%= business.seo.image %>" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="en_SE" />
  <meta property="og:site_name" content="<%= business.name %>" />

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content="<%= business.canonical || business.seo.canonicalUrl %>" />
  <meta property="twitter:title" content="<%= business.pageTitle || business.seo.title %>" />
  <meta property="twitter:description" content="<%= business.pageDescription || business.seo.description %>" />
  <meta property="twitter:image" content="<%= business.seo.image %>" />

  <!-- Local Business Schema -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "NailSalon",
      "name": "<%= business.name %>",
      "description": "<%= business.seo.description %>",
      "url": "<%= business.seo.canonicalUrl %>",
      "telephone": "<%= business.phone %>",
      "email": "<%= business.email %>",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "<%= business.location.city %>",
        "addressRegion": "<%= business.location.region %>",
        "addressCountry": "<%= business.location.country %>",
        "postalCode": "<%= business.location.postalCode %>"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 56.8777,
        "longitude": 14.8091
      },
      "openingHoursSpecification": [
        <% business.hours.structured.forEach((hour, index) => { %>
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": "<%= hour.day %>",
          "opens": "<%= hour.opens %>",
          "closes": "<%= hour.closes %>"
        }<%= index < business.hours.structured.length - 1 ? ',' : '' %>
        <% }) %>
      ],
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "<%= business.reviews.rating %>",
        "reviewCount": "<%= business.reviews.reviewCount %>",
        "bestRating": "<%= business.reviews.bestRating %>",
        "worstRating": "<%= business.reviews.worstRating %>"
      },
      "priceRange": "250-550 SEK",
      "image": "<%= business.seo.image %>",
      "sameAs": [
        "<%= business.socialMedia.instagramUrl %>",
        "<%= business.socialMedia.tiktokUrl %>"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Nail Care Services",
        "itemListElement": [
          <% business.services.forEach((service, index) => { %>
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "<%= service.name %>",
              "description": "<%= service.description %>"
            },
            "priceSpecification": {
              "@type": "PriceSpecification",
              "price": "<%= service.price %>",
              "priceCurrency": "SEK"
            }
          }<%= index < business.services.length - 1 ? ',' : '' %>
          <% }) %>
        ]
      }
    }
    </script>

  <!-- Service Schema -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": "Nail Care Services",
      "description": "Professional nail care services offered by <%= business.name %>",
      "itemListElement": [
        <% business.services.forEach((service, index) => { %>
        {
          "@type": "ListItem",
          "position": <%= index + 1 %>,
          "item": {
            "@type": "Service",
            "@id": "<%= business.seo.canonicalUrl %>#<%= service.name.toLowerCase().replace(/\s+/g, '-') %>",
            "name": "<%= service.name %>",
            "description": "<%= service.description %>",
            "provider": {
              "@type": "NailSalon",
              "name": "<%= business.name %>"
            },
            "offers": {
              "@type": "Offer",
              "priceRange": "<%= service.price %>",
              "priceCurrency": "SEK"
            }
          }
        }<%= index < business.services.length - 1 ? ',' : '' %>
        <% }) %>
      ]
    }
    </script>

  <!-- Breadcrumb Schema -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [{
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "<%= business.seo.canonicalUrl %>"
      }]
    }
    </script>

  <!-- Fonts -->
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap"
    rel="stylesheet" media="swap" />

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw=="
    crossorigin="anonymous" referrerpolicy="no-referrer" />

  <style>
    .hero-gradient {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .nail-gradient {
      background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    }

    .elegant-gradient {
      background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
    }

    .floating {
      animation: floating 3s ease-in-out infinite;
    }

    @keyframes floating {

      0%,
      100% {
        transform: translateY(0px);
      }

      50% {
        transform: translateY(-10px);
      }
    }

    .fade-in {
      animation: fadeIn 1s ease-in;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(30px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Image wrapper — shows a soft fallback when the image is missing */
    .img-wrap {
      overflow: hidden;
      background: linear-gradient(135deg, #f9f0ff, #fce7f3);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.3s ease;
    }

    .img-wrap img.broken {
      display: none;
    }

    /* Shown when the image fails to load */
    .img-wrap .img-fallback {
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: #c084fc;
      font-size: 13px;
      text-align: center;
      padding: 8px;
      gap: 6px;
    }

    .img-wrap img.broken~.img-fallback {
      display: flex;
    }

    .img-wrap:hover img:not(.broken) {
      transform: scale(1.05);
    }

    .service-card {
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .service-card:hover {
      transform: translateY(-8px) scale(1.02);
    }

    .glass-effect {
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.2);
    }
  </style>
</head>

<body class="bg-gray-50">
  <!-- Skip to main content for accessibility -->
  <a href="#main-content"
    class="sr-only focus:not-sr-only focus:absolute focus:top-0 focus:left-0 bg-blue-600 text-white p-2 z-50">
    Skip to main content
  </a>

  <!-- Navigation -->
  <nav class="fixed top-0 w-full bg-white/90 backdrop-blur-lg shadow-lg z-50" role="navigation"
    aria-label="Main navigation">
    <div class="container mx-auto px-4 py-3">
      <div class="flex justify-between items-center">
        <div class="flex items-center space-x-2">
          <i class="fas fa-gem text-2xl text-pink-500" aria-hidden="true"></i>
          <span class="text-xl font-bold text-gray-800" style="font-family: 'Playfair Display', serif">
            <%= business.name %>
          </span>
        </div>
        <div class="hidden md:flex space-x-6">
          <a href="#home" class="text-gray-700 hover:text-pink-500 transition-colors">Home</a>
          <a href="#gallery" class="text-gray-700 hover:text-pink-500 transition-colors">Gallery</a>
          <a href="#services" class="text-gray-700 hover:text-pink-500 transition-colors">Services</a>
          <a href="#contact" class="text-gray-700 hover:text-pink-500 transition-colors">Contact</a>
        </div>
        <a href="tel:<%= business.phone %>"
          class="bg-pink-500 text-white px-4 py-2 rounded-full hover:bg-pink-600 transition-colors"
          aria-label="Call to book appointment">
          <i class="fas fa-phone mr-2" aria-hidden="true"></i>Book Now
        </a>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <main id="main-content">

    <!-- ═══════════════════════════════════════════ HERO ══ -->
    <section id="home" class="min-h-screen hero-gradient flex items-center justify-center relative overflow-hidden"
      aria-label="Welcome to NailsByCeline">
      <div class="absolute inset-0 opacity-20" aria-hidden="true">
        <div class="absolute top-10 left-10 w-20 h-20 bg-white rounded-full floating"></div>
        <div class="absolute top-1/3 right-20 w-16 h-16 bg-pink-200 rounded-full floating" style="animation-delay:-1s">
        </div>
        <div class="absolute bottom-1/4 left-1/4 w-12 h-12 bg-purple-200 rounded-full floating"
          style="animation-delay:-2s"></div>
      </div>

      <div class="container mx-auto px-4 text-center relative z-10">
        <div class="max-w-4xl mx-auto fade-in">
          <h1 class="text-5xl md:text-7xl font-bold text-white mb-6" style="font-family: 'Playfair Display', serif">
            <%= business.name %>
          </h1>
          <p class="text-xl md:text-2xl text-white/90 mb-8">
            Professional Nail Salon in <%= business.location.city %> — <%= business.tagline %>
          </p>
          <p class="text-lg text-white/80 mb-8">
            Expert nail care services including gel manicures, nail art, and French tips.
            Over <%= business.reviews.reviewCount %> happy clients with <%= business.reviews.rating %>★ average rating.
          </p>

          <div class="flex flex-col md:flex-row gap-4 justify-center items-center mb-12">
            <a href="#services"
              class="bg-white text-purple-700 px-8 py-4 rounded-full font-semibold hover:bg-gray-100 transition-all transform hover:scale-105">
              View Services
            </a>
            <a href="/cdn-cgi/l/email-protection#714d544c51130402181f1402025f141c10181d51544f"
              class="border-2 border-white text-white px-8 py-4 rounded-full font-semibold hover:bg-white hover:text-purple-700 transition-all transform hover:scale-105">
              <i class="fas fa-envelope mr-2" aria-hidden="true"></i>
              <%= business.email %>
            </a>
          </div>

          <!-- Hero image row -->
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto">
            <div class="img-wrap h-32 rounded-lg glass-effect">
              <img src="/images/professional-nail-art-showcase-vaxjo.webp"
                alt="Professional nail art showcase featuring intricate designs" loading="lazy"
                onerror="this.classList.add('broken')">
              <div class="img-fallback"><i class="fas fa-spa text-2xl"></i><span>Nail Art Showcase</span></div>
            </div>
            <div class="img-wrap h-32 rounded-lg glass-effect">
              <img src="/images/manicure-process-nailsbyceline.webp" alt="Manicure process at NailsByCeline salon"
                loading="lazy" onerror="this.classList.add('broken')">
              <div class="img-fallback"><i class="fas fa-spa text-2xl"></i><span>Manicure Process</span></div>
            </div>
            <div class="img-wrap h-32 rounded-lg glass-effect">
              <img src="/images/modern-nail-salon-interior-vaxjo.webp"
                alt="Clean and modern nail salon interior in Växjö" loading="lazy"
                onerror="this.classList.add('broken')">
              <div class="img-fallback"><i class="fas fa-store text-2xl"></i><span>Studio Interior</span></div>
            </div>
            <div class="img-wrap h-32 rounded-lg glass-effect">
              <img src="/images/satisfied-client-beautiful-nails.webp" alt="Happy client showing beautiful nail results"
                loading="lazy" onerror="this.classList.add('broken')">
              <div class="img-fallback"><i class="fas fa-smile text-2xl"></i><span>Happy Client</span></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════ GALLERY ══ -->
    <section id="gallery" class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-bold text-gray-800 mb-4" style="font-family: 'Playfair Display', serif">
            Professional Nail Art Gallery
          </h2>
          <p class="text-xl text-gray-600 max-w-2xl mx-auto">
            Discover our stunning nail art creations from our <%= business.location.city %> salon.
              Each design is carefully crafted with attention to detail and quality.
          </p>
        </div>

        <!-- Featured gallery -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
          <article class="rounded-xl overflow-hidden shadow-md hover:shadow-xl transition-shadow">
            <div class="img-wrap h-80">
              <img src="/images/elegant-french-manicure-gold-accents.webp"
                alt="Elegant French Manicure with Gold Accents - Professional nail art in Växjö" loading="lazy"
                onerror="this.classList.add('broken')">
              <div class="img-fallback"><i class="fas fa-spa text-3xl"></i><span>French Manicure<br>with Gold
                  Accents</span></div>
            </div>
          </article>
          <article class="rounded-xl overflow-hidden shadow-md hover:shadow-xl transition-shadow">
            <div class="img-wrap h-80">
              <img src="/images/colorful-geometric-nail-art-design.webp"
                alt="Colorful Nail Art with Geometric Patterns - Custom nail designs" loading="lazy"
                onerror="this.classList.add('broken')">
              <div class="img-fallback"><i class="fas fa-spa text-3xl"></i><span>Colorful Nail Art<br>Geometric
                  Patterns</span></div>
            </div>
          </article>
          <article class="rounded-xl overflow-hidden shadow-md hover:shadow-xl transition-shadow">
            <div class="img-wrap h-80">
              <img src="/images/acrylic-extensions-ombre-design.webp"
                alt="Acrylic Extensions with Ombre Design - Long lasting nail extensions" loading="lazy"
                onerror="this.classList.add('broken')">
              <div class="img-fallback"><i class="fas fa-spa text-3xl"></i><span>Acrylic Extensions<br>with Ombre
                  Design</span></div>
            </div>
          </article>
        </div>

        <!-- Gallery grid -->
        <% const galleryImages=[ { src: '/images/professional-gel-manicure-vaxjo.webp' ,
          alt: 'Professional gel manicure in Växjö' }, { src: '/images/custom-nail-art-designs.webp' ,
          alt: 'Custom nail art designs' }, { src: '/images/french-tips-classic-elegance.webp' ,
          alt: 'French tips classic elegance' }, { src: '/images/nail-extensions-long-lasting.webp' ,
          alt: 'Long-lasting nail extensions' }, { src: '/images/creative-nail-patterns.webp' ,
          alt: 'Creative nail patterns' }, ]; %>
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
            <% galleryImages.forEach((img)=> { %>
              <div class="img-wrap h-48 rounded-lg shadow hover:shadow-lg transition-shadow">
                <img src="<%= img.src %>" alt="<%= img.alt %>" loading="lazy" onerror="this.classList.add('broken')">
                <div class="img-fallback"><i class="fas fa-spa text-xl"></i><span class="text-xs">
                    <%= img.alt %>
                  </span></div>
              </div>
              <% }) %>
          </div>

          <!-- Instagram feed -->
          <% const instaImages=[ { src: '/images/daily-nail-art-inspiration-1.webp' , alt: 'Daily nail art inspiration'
            }, { src: '/images/client-transformation-before-after.webp' , alt: 'Client transformation' }, {
            src: '/images/seasonal-nail-design-trends.webp' , alt: 'Seasonal nail design trends' }, {
            src: '/images/professional-nail-care-process.webp' , alt: 'Professional nail care process' }, {
            src: '/images/nail-art-detail-close-up.webp' , alt: 'Nail art detail close-up' }, {
            src: '/images/happy-client-testimonial.webp' , alt: 'Happy client testimonial' }, ]; %>
            <div class="mt-16 text-center">
              <h3 class="text-2xl font-bold text-gray-800 mb-8">Follow Our Latest Work on Instagram</h3>
              <div class="grid grid-cols-3 md:grid-cols-6 gap-4 max-w-4xl mx-auto">
                <% instaImages.forEach((img)=> { %>
                  <div class="img-wrap h-32 rounded-lg shadow">
                    <img src="<%= img.src %>" alt="<%= img.alt %>" loading="lazy"
                      onerror="this.classList.add('broken')">
                    <div class="img-fallback"><i class="fab fa-instagram text-xl text-pink-400"></i></div>
                  </div>
                  <% }) %>
              </div>
              <a href="<%= business.socialMedia.instagramUrl %>"
                class="inline-block mt-8 bg-gradient-to-r from-pink-500 to-purple-600 text-white px-8 py-3 rounded-full font-semibold hover:from-pink-600 hover:to-purple-700 transition-all transform hover:scale-105"
                target="_blank" rel="noopener" aria-label="Follow us on Instagram">
                <i class="fab fa-instagram mr-2" aria-hidden="true"></i>Follow <%= business.socialMedia.instagram %>
              </a>
            </div>
      </div>
    </section>

    <!-- ═════════════════════════════════════════ SERVICES ══ -->
    <section id="services" class="py-20 elegant-gradient">
      <div class="container mx-auto px-4">
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-bold text-gray-800 mb-4" style="font-family: 'Playfair Display', serif">
            Professional Nail Care Services in <%= business.location.city %>
          </h2>
          <p class="text-xl text-gray-600 max-w-2xl mx-auto">
            Expert nail care services tailored to your style and preferences.
            All treatments use premium products and follow strict hygiene standards.
          </p>
        </div>

        <% const serviceImages=[ { src: '/images/classic-manicure-service-vaxjo.webp' , alt: 'Classic manicure service'
          }, { src: '/images/gel-manicure-long-lasting-shine.webp' , alt: 'Gel manicure long-lasting shine' }, {
          src: '/images/custom-nail-art-design-service.webp' , alt: 'Custom nail art design service' }, ]; %>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <% business.services.forEach((service, index)=> { %>
              <article class="service-card bg-white rounded-2xl p-8 shadow-lg hover:shadow-2xl"
                id="<%= service.name.toLowerCase().replace(/\s+/g, '-') %>">
                <div class="img-wrap h-48 rounded-xl mb-6 shadow-sm">
                  <img src="<%= serviceImages[index] ? serviceImages[index].src : '' %>"
                    alt="<%= service.name %> service at NailsByCeline" loading="lazy"
                    onerror="this.classList.add('broken')">
                  <div class="img-fallback">
                    <i class="fas fa-hand-sparkles text-3xl text-pink-400"></i>
                    <span class="text-sm font-medium">
                      <%= service.name %>
                    </span>
                  </div>
                </div>
                <h3 class="text-xl font-bold text-gray-800 mb-3">
                  <%= service.name %>
                </h3>
                <p class="text-gray-600 mb-4">
                  <%= service.description %>
                </p>
                <p class="text-sm text-gray-500 mb-4">
                  <i class="fas fa-clock mr-2" aria-hidden="true"></i>Duration: <%= service.duration %>
                </p>
                <div class="flex justify-between items-center">
                  <span class="text-2xl font-bold text-pink-600">
                    <%= service.price %>
                  </span>
                  <a href="tel:<%= business.phone %>"
                    class="bg-pink-500 text-white px-6 py-2 rounded-full hover:bg-pink-600 transition-colors"
                    aria-label="Call to book <%= service.name %> appointment">
                    Book Now
                  </a>
                </div>
              </article>
              <% }) %>
          </div>

          <!-- Before / After -->
          <% const beforeAfterImages=[ { before: '/images/nail-transformation-before-1.webp' ,
            after: '/images/nail-transformation-after-1.webp' }, { before: '/images/nail-transformation-before-2.webp' ,
            after: '/images/nail-transformation-after-2.webp' }, { before: '/images/nail-transformation-before-3.webp' ,
            after: '/images/nail-transformation-after-3.webp' }, ]; %>
            <div class="mt-20">
              <h3 class="text-3xl font-bold text-center text-gray-800 mb-12">Before &amp; After Transformations</h3>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <% beforeAfterImages.forEach((pair, i)=> { %>
                  <div class="bg-white rounded-2xl p-6 shadow-lg">
                    <div class="grid grid-cols-2 gap-4">
                      <div class="text-center">
                        <h4 class="text-sm font-semibold text-gray-600 mb-2">BEFORE</h4>
                        <div class="img-wrap h-40 rounded-lg">
                          <img src="<%= pair.before %>" alt="Before transformation <%= i + 1 %>" loading="lazy"
                            onerror="this.classList.add('broken')">
                          <div class="img-fallback"><i class="fas fa-image text-xl"></i><span
                              class="text-xs">Before</span></div>
                        </div>
                      </div>
                      <div class="text-center">
                        <h4 class="text-sm font-semibold text-gray-600 mb-2">AFTER</h4>
                        <div class="img-wrap h-40 rounded-lg">
                          <img src="<%= pair.after %>" alt="After transformation <%= i + 1 %>" loading="lazy"
                            onerror="this.classList.add('broken')">
                          <div class="img-fallback"><i class="fas fa-image text-xl"></i><span
                              class="text-xs">After</span></div>
                        </div>
                      </div>
                    </div>
                    <p class="text-center text-sm text-gray-600 mt-3">Transformation <%= i + 1 %>
                    </p>
                  </div>
                  <% }) %>
              </div>
            </div>

            <!-- Local SEO -->
            <div class="mt-16 bg-white rounded-2xl p-8 shadow-lg text-center">
              <h3 class="text-2xl font-bold text-gray-800 mb-4">
                <%= business.location.city %>'s Premier Nail Salon
              </h3>
              <p class="text-gray-600 mb-6">
                Conveniently located in <%= business.location.city %>, <%= business.location.region %>, Sweden.
                    We serve clients throughout the greater <%= business.location.city %> area with professional
