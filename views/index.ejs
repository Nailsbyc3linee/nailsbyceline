  <!-- Scroll to top button -->
  <button id="scrollToTop"
    class="fixed bottom-6 left-6 bg-gray-800 hover:bg-gray-700 text-white p-3 rounded-full shadow-lg opacity-0 invisible transition-all duration-300 z-50"
    aria-label="Scroll to top of page">
    <i class="fas fa-chevron-up" aria-hidden="true"></i>
  </button>

  <script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script>
  <script>
    // Booking form — Web3Forms
    const bookingForm = document.getElementById("bookingForm");
    const bookingBtn = document.getElementById("bookingSubmitBtn");
    const bookingBtnText = document.getElementById("bookingBtnText");
    const formMessage = document.getElementById("formMessage");

    bookingForm.addEventListener("submit", async function (e) {
      e.preventDefault();

      // Loading state
      bookingBtnText.textContent = "Sending…";
      bookingBtn.disabled = true;
      formMessage.className = "hidden";

      try {
        const res = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: new FormData(bookingForm),
        });
        const data = await res.json();

        if (data.success) {
          formMessage.textContent = "✓ Booking request sent! We'll confirm your appointment within 24 hours.";
          formMessage.className = "mb-5 p-4 rounded-xl text-sm font-medium bg-green-50 border border-green-200 text-green-700";
          bookingForm.reset();
        } else {
          throw new Error(data.message || "Submission failed");
        }
      } catch (err) {
        formMessage.textContent = "Something went wrong — please call us directly or try again.";
        formMessage.className = "mb-5 p-4 rounded-xl text-sm font-medium bg-red-50 border border-red-200 text-red-700";
      } finally {
        bookingBtnText.textContent = "Book Appointment";
        bookingBtn.disabled = false;
        formMessage.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }
    });

    // Smooth scroll (offset for fixed header)
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener("click", function (e) {
        e.preventDefault();
        const id = this.getAttribute("href").substring(1);
        const target = document.getElementById(id);
        if (target) {
          window.scrollTo({ top: target.getBoundingClientRect().top + window.pageYOffset - 80, behavior: "smooth" });
          history.pushState(null, null, `#${id}`);
        }
      });
    });

    // Scroll to top button
    const scrollBtn = document.getElementById("scrollToTop");
    if (scrollBtn) {
      window.addEventListener("scroll", () => {
        if (window.pageYOffset > 300) scrollBtn.classList.remove("opacity-0", "invisible");
        else scrollBtn.classList.add("opacity-0", "invisible");
      });
      scrollBtn.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));
    }

    // Fade-in on scroll
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(entries => {
        entries.forEach(e => { if (e.isIntersecting) e.target.classList.add("fade-in"); });
      });
      document.querySelectorAll(".service-card, article").forEach(el => observer.observe(el));
    }

    // Service Worker (PWA)
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => { }));
    }
  </script>

  <!-- Google Analytics — replace GA_TRACKING_ID with your real ID -->
